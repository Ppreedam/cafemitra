DJANGO_SECRET_KEY=replace-with-production-secret
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=api.repetigo.com,repetigo.com,www.repetigo.com
DATABASE_URL=postgresql://postgres.PROJECT_REF:REPLACE_WITH_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
CORS_ALLOWED_ORIGINS=https://repetigo.com,https://www.repetigo.com
CSRF_TRUSTED_ORIGINS=https://repetigo.com,https://www.repetigo.com
FRONTEND_URL=https://repetigo.com
AI_UPSCALE_API_URL=
AI_UPSCALE_API_KEY=
AI_UPSCALE_TIMEOUT=120
GEMINI_API_KEY=
GEMINI_TIMEOUT=60
OPENAI_API_KEY=
OPENAI_TIMEOUT=90
WEBSITE_SCREENSHOT_API_URL=
WEBSITE_SCREENSHOT_API_KEY=
WEBSITE_SCREENSHOT_TIMEOUT=120

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_USE_TLS=1
SMTP_TIMEOUT=15
SMTP_USER=support@repetigo.com
SMTP_PASSWORD=replace-with-smtp-password
DEFAULT_FROM_EMAIL=support@repetigo.com
PHONEPE_ENABLED=0
PHONEPE_MODE=test
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=
PAYU_ENABLED=0
PAYU_MODE=test
PAYU_MERCHANT_KEY=
PAYU_SALT=
PAYU_CLIENT_ID=
PAYU_CLIENT_SECRET=
RAZORPAY_ENABLED=0
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
DIRECT_UPI_ENABLED=1

# Shared secret for the website's /api/revalidate (blog publish -> instant refresh). Set the same value in the Next.js app.
REVALIDATE_SECRET=

# External media API used by the admin blog editor's "Set Featured Image" upload
# (POST {MEDIA_API_URL}/upload.php with header X-API-Key). Keep the key ONLY here
# (server side) - never in the admin/client apps. Blog images are stored ONLY
# there (the DB keeps just the returned URL); uploads fail if these are empty.
MEDIA_API_URL=https://media.startuptourch.com/media-api
MEDIA_API_KEY=
